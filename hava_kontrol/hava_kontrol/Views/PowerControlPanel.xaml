<UserControl x:Class="hava_kontrol.Views.PowerControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="420">

    <Border Style="{StaticResource CardBorder}" Padding="12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="GÜÇ ÇIKIŞLARI" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🛑  TÜM KAPAT"
                        Command="{Binding TurnOffAllPowerOutputsCommand}"
                        Style="{StaticResource DangerButton}"
                        Padding="10,3"
                        Height="26"
                        FontSize="11"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Tablo Başlığı (Durum sağa kaydırılmış) -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ÇIKIŞ"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10" />
                <TextBlock Grid.Column="1" Text="DURUM"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10"
                           Margin="0,0,16,0"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="KONTROL"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10"
                           TextAlignment="Center" />
            </Grid>

            <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,3" />

            <!-- Güç Çıkışları Listesi (Durum Sağa Kaydırılmış, Simetrik Düzen) -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding PowerOutputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" Rows="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,2" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="105" />
                                </Grid.ColumnDefinitions>

                                <!-- Çıkış Adı (Sola dayalı) -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding OutputName}"
                                           Style="{StaticResource CardTitle}"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Durum Göstergesi (Sağa kaydırılmış) -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="5,0,0,0"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding StatusColor}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Kontrol Butonları (Sağa dayalı grup) -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Content="ON"
                                            Command="{Binding PowerOnCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            Height="24" Width="46"
                                            Padding="0"
                                            Margin="0,0,5,0"
                                            FontSize="11" FontWeight="Bold" />
                                    <Button Content="OFF"
                                            Command="{Binding PowerOffCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Height="24" Width="52"
                                            Padding="0"
                                            FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
