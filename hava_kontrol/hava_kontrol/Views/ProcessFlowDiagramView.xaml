<UserControl x:Class="hava_kontrol.Views.ProcessFlowDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:hava_kontrol.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1800">

    <UserControl.Resources>
        <!-- ============================================ -->
        <!-- P&ID STANDART VALF KART BUTONU STİLİ (MAVİ)   -->
        <!-- ============================================ -->
        <Style x:Key="ValveDiagramButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Command" Value="{Binding ToggleCommand}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="valveCard"
                                Background="#EEF6FF"
                                BorderBrush="{Binding StatusBorderBrush}"
                                BorderThickness="1.8"
                                CornerRadius="8"
                                Padding="4,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Üst Başlık: VALF 1..8 -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding DiagramLabel}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#1C4A78"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1" />

                                <!-- Vana P&ID Sembolü (Kum Saati + Aktüatör) -->
                                <Canvas Grid.Row="1" Width="40" Height="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent">
                                    <Polygon Points="2,2 20,10 2,18"
                                             Fill="{Binding StatusFillBrush}"
                                             Stroke="{Binding StatusBorderBrush}"
                                             StrokeThickness="1.8" />
                                    <Polygon Points="38,2 20,10 38,18"
                                             Fill="{Binding StatusFillBrush}"
                                             Stroke="{Binding StatusBorderBrush}"
                                             StrokeThickness="1.8" />
                                    <Line X1="20" Y1="10" X2="20" Y2="1"
                                          Stroke="{Binding StatusBorderBrush}"
                                          StrokeThickness="1.8" />
                                    <Line X1="14" Y1="1" X2="26" Y2="1"
                                          Stroke="{Binding StatusBorderBrush}"
                                          StrokeThickness="1.8" />
                                </Canvas>

                                <!-- Alt Durum Rozeti (● AÇIK / ● KAPALI) -->
                                <Border Grid.Row="2"
                                        Background="{Binding StatusFillBrush}"
                                        BorderBrush="{Binding StatusBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        HorizontalAlignment="Center"
                                        Margin="0,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5"
                                                 Fill="{Binding StatusColor}"
                                                 Margin="0,0,3,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="8" FontWeight="Bold"
                                                   Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="valveCard" Property="Background" Value="#F0FDF4" />
                                <Setter TargetName="valveCard" Property="BorderBrush" Value="#22C55E" />
                                <Setter TargetName="valveCard" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="valveCard" Property="Background" Value="#FFFBEB" />
                                <Setter TargetName="valveCard" Property="BorderBrush" Value="#F59E0B" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="valveCard" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="valveCard" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.30" Color="#2563EB" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="valveCard" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- TAHLİYE / EGZOZ VALF BUTONU STİLİ (TURUNCU)  -->
        <!-- ============================================ -->
        <Style x:Key="OrangeValveDiagramButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Command" Value="{Binding ToggleCommand}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="orangeValveCard"
                                Background="#FFF1E0"
                                BorderBrush="#D17A1F"
                                BorderThickness="1.8"
                                CornerRadius="8"
                                Padding="4,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Üst Başlık: VALF 13..16 -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding DiagramLabel}"
                                           FontSize="9.5" FontWeight="Bold"
                                           Foreground="#8A4B0A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1" />

                                <!-- Vana P&ID Sembolü (Turuncu) -->
                                <Canvas Grid.Row="1" Width="38" Height="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent">
                                    <Polygon Points="2,2 19,9 2,16"
                                             Fill="{Binding StatusFillBrush}"
                                             Stroke="#D17A1F"
                                             StrokeThickness="1.8" />
                                    <Polygon Points="36,2 19,9 36,16"
                                             Fill="{Binding StatusFillBrush}"
                                             Stroke="#D17A1F"
                                             StrokeThickness="1.8" />
                                    <Line X1="19" Y1="9" X2="19" Y2="1"
                                          Stroke="#D17A1F"
                                          StrokeThickness="1.8" />
                                    <Line X1="13" Y1="1" X2="25" Y2="1"
                                          Stroke="#D17A1F"
                                          StrokeThickness="1.8" />
                                </Canvas>

                                <!-- Alt Durum Rozeti -->
                                <Border Grid.Row="2"
                                        Background="#FDECE0"
                                        BorderBrush="#D17A1F"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        HorizontalAlignment="Center"
                                        Margin="0,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5"
                                                 Fill="{Binding StatusColor}"
                                                 Margin="0,0,3,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="7.5" FontWeight="Bold"
                                                   Foreground="#8A4B0A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="orangeValveCard" Property="Background" Value="#FEF3C7" />
                                <Setter TargetName="orangeValveCard" Property="BorderBrush" Value="#D97706" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="orangeValveCard" Property="BorderBrush" Value="#B45309" />
                                <Setter TargetName="orangeValveCard" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="1.5" Opacity="0.32" Color="#D97706" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="orangeValveCard" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- ŞEMA ÜST BAŞLIK VE HIZLI EMNİYET BUTONLARI   -->
            <!-- ============================================ -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⛯" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="P&amp;ID SÜREÇ VE AKIŞ ŞEMASI"
                               Style="{StaticResource SectionTitle}"
                               FontSize="13.5" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0"
                            ToolTip="VALF 8 artık sensör çıkışında değil, karışım manifoldunun tahliye (egzoz) hattındadır. Sensör hücre çıkışı doğrudan atmosfere bağlıdır.">
                        <TextBlock Text="Manifold Tahliye &amp; Çoklu V-OVG Mimarisi 🛈" FontSize="9.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    </Border>
                </StackPanel>

                <!-- Güç Çıkışları ve Hızlı Emniyet Kapatma Butonları -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tüm Valfleri Kapat Butonu -->
                    <Button Command="{Binding CloseAllValvesCommand}"
                            ToolTip="Sistemdeki tüm gaz ve tahliye valflerini anında kapatır (V1 - V8, V13 - V16)"
                            Height="26" Padding="8,0" Margin="0,0,5,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder"
                                        Background="#FEF2F2"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1.2"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔒" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="TÜM VALFLERİ KAPAT" FontSize="9" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FECACA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tüm Çıkışları Kapat Butonu -->
                    <Button Command="{Binding TurnOffAllPowerOutputsCommand}"
                            ToolTip="Tüm PLC röle güç çıkışlarını kapatır (Y0.8 - Y0.11)"
                            Height="26" Padding="8,0" Margin="0,0,8,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder"
                                        Background="#FFFBEB"
                                        BorderBrush="#F59E0B"
                                        BorderThickness="1.2"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="TÜM ÇIKIŞLARI KAPAT" FontSize="9" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FEF3C7" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FDE68A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Dikey İnce Ayraç -->
                    <Rectangle Width="1" Height="16" Fill="{StaticResource CardBorderBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- Güç Çıkışları Başlığı -->
                    <TextBlock Text="GÜÇ ÇIKIŞLARI:"
                               Style="{StaticResource MutedText}"
                               FontSize="9.5" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,5,0" />

                    <!-- Genişletilmiş Güç Çıkışları Butonları (Y0.8 - Y0.11) -->
                    <ItemsControl ItemsSource="{Binding PowerOutputs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PowerOutputViewModel}">
                                <Button Command="{Binding ToggleCommand}"
                                        ToolTip="{Binding FunctionalName, StringFormat='{}{0} — Tıklayarak Aç/Kapat'}"
                                        Margin="0,0,4,0" Padding="6,2" MinWidth="68" Height="26"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pwrBorder"
                                                    Background="{StaticResource BgBrush}"
                                                    BorderBrush="{Binding StatusColor}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ButtonLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="pwrBorder" Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pwrBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- ============================================ -->
            <!-- ANA P&ID VEKTÖR ŞEMASI (1800 x 900)          -->
            <!-- BÜYÜTÜLMÜŞ, ALANA TAM OTURAN DÜZEN           -->
            <!-- ============================================ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Canvas Width="1800" Height="900" Background="Transparent" ClipToBounds="True">

                    <!-- ============================================ -->
                    <!-- 2. BORU HATLARI (PIPELINES)                  -->
                    <!-- ============================================ -->

                    <!-- Hat 1 (GAZ 1): Y=55 -->
                    <Line X1="210" Y1="55" X2="270" Y2="55" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="264,51 270,55 264,59" Fill="#2F6FB0" />
                    <Line X1="366" Y1="55" X2="416" Y2="55" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="410,51 416,55 410,59" Fill="#2F6FB0" />
                    <Line X1="606" Y1="55" X2="810" Y2="55" Stroke="#2F6FB0" StrokeThickness="2.8" />

                    <!-- Hat 2 (GAZ 2): Merkez Y=195 -> V-OVG 2 -> Üst Y=145, Alt Y=245 -->
                    <Line X1="210" Y1="195" X2="270" Y2="195" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="264,191 270,195 264,199" Fill="#2F6FB0" />
                    <!-- Üst Kol (VALF 2 -> MFC-2 -> Manifold) -->
                    <Line X1="394" Y1="175" X2="420" Y2="145" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Polygon Points="415,148 420,145 416,153" Fill="#279A7A" />
                    <Line X1="516" Y1="145" X2="566" Y2="145" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="560,141 566,145 560,149" Fill="#2F6FB0" />
                    <Line X1="756" Y1="145" X2="810" Y2="145" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <!-- Alt Kol (VALF 13 -> Egzoz) -->
                    <Line X1="394" Y1="215" X2="440" Y2="245" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Line X1="536" Y1="245" X2="586" Y2="245" Stroke="#D17A1F" StrokeThickness="2.4" />
                    <Polygon Points="580,241 586,245 580,249" Fill="#D17A1F" />

                    <!-- Hat 3 (GAZ 3): Merkez Y=370 -> V-OVG 3 -> Üst Y=320, Alt Y=420 -->
                    <Line X1="210" Y1="370" X2="270" Y2="370" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="264,366 270,370 264,374" Fill="#2F6FB0" />
                    <!-- Üst Kol (VALF 3 -> MFC-3 -> Manifold) -->
                    <Line X1="394" Y1="350" X2="420" Y2="320" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Polygon Points="415,323 420,320 416,328" Fill="#279A7A" />
                    <Line X1="516" Y1="320" X2="566" Y2="320" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="560,316 566,320 560,324" Fill="#2F6FB0" />
                    <Line X1="756" Y1="320" X2="810" Y2="320" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <!-- Alt Kol (VALF 14 -> Egzoz) -->
                    <Line X1="394" Y1="390" X2="440" Y2="420" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Line X1="536" Y1="420" X2="586" Y2="420" Stroke="#D17A1F" StrokeThickness="2.4" />
                    <Polygon Points="580,416 586,420 580,424" Fill="#D17A1F" />

                    <!-- Hat 4 (GAZ 4): Merkez Y=545 -> V-OVG 4 -> Üst Y=495, Alt Y=595 -->
                    <Line X1="210" Y1="545" X2="270" Y2="545" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="264,541 270,545 264,549" Fill="#2F6FB0" />
                    <!-- Üst Kol (VALF 4 -> MFC-4 -> Manifold) -->
                    <Line X1="394" Y1="525" X2="420" Y2="495" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Polygon Points="415,498 420,495 416,503" Fill="#279A7A" />
                    <Line X1="516" Y1="495" X2="566" Y2="495" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="560,491 566,495 560,499" Fill="#2F6FB0" />
                    <Line X1="756" Y1="495" X2="810" Y2="495" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <!-- Alt Kol (VALF 15 -> Egzoz) -->
                    <Line X1="394" Y1="565" X2="440" Y2="595" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Line X1="536" Y1="595" X2="586" Y2="595" Stroke="#D17A1F" StrokeThickness="2.4" />
                    <Polygon Points="580,591 586,595 580,599" Fill="#D17A1F" />

                    <!-- Hat 5 (KURU HAVA JENERATÖRÜ): Merkez Y=720 -> V-OVG 1 -> Üst Y=670, Alt Y=770 -->
                    <Line X1="210" Y1="720" X2="270" Y2="720" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <Polygon Points="264,716 270,720 264,724" Fill="#2F6FB0" />
                    <!-- Üst Kol (VALF 5 -> Doğrudan Manifold) -->
                    <Line X1="394" Y1="700" X2="420" Y2="670" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Polygon Points="415,673 420,670 416,678" Fill="#279A7A" />
                    <Line X1="516" Y1="670" X2="810" Y2="670" Stroke="#2F6FB0" StrokeThickness="2.8" />
                    <!-- Alt Kol (VALF 16 -> Egzoz) -->
                    <Line X1="394" Y1="740" X2="440" Y2="770" Stroke="#279A7A" StrokeThickness="2.2" />
                    <Line X1="536" Y1="770" X2="586" Y2="770" Stroke="#D17A1F" StrokeThickness="2.4" />
                    <Polygon Points="580,766 586,770 580,774" Fill="#D17A1F" />

                    <!-- Kuru Hava Bypass / Sensör Temizleme Hattı (VALF 7) -->
                    <Polyline Points="115,750 115,865 260,865" Stroke="#8A8A8A" StrokeThickness="2.4" StrokeDashArray="5,3" Fill="Transparent" />
                    <Polyline Points="356,865 1235,865 1235,420" Stroke="#8A8A8A" StrokeThickness="2.4" StrokeDashArray="5,3" Fill="Transparent" />
                    <Polygon Points="1231,428 1235,420 1239,428" Fill="#8A8A8A" />

                    <!-- ============================================ -->
                    <!-- 3. KARIŞIM MANİFOLDU VE ÇIKIŞ HATTI          -->
                    <!-- ============================================ -->
                    <!-- Dikey Toplama Hattı (X=810, Y=55..670) -->
                    <Line X1="810" Y1="55" X2="810" Y2="670" Stroke="#2F6FB0" StrokeThickness="4" />

                    <!-- Manifold Giriş Hattı (X=810..860, Y=420) -->
                    <Line X1="810" Y1="420" X2="860" Y2="420" Stroke="#2F6FB0" StrokeThickness="4" />

                    <!-- Manifold Çıkışından Ayrım Noktasına (X=1030..1080, Y=420) -->
                    <Line X1="1030" Y1="420" X2="1080" Y2="420" Stroke="#2F6FB0" StrokeThickness="4" />
                    <Ellipse Canvas.Left="1075" Canvas.Top="415" Width="10" Height="10" Fill="#2F6FB0" />

                    <!-- Manifold Tahliye Kolu (Aşağı: VALF 8 -> Egzoz) -->
                    <Line X1="1080" Y1="420" X2="1080" Y2="520" Stroke="#2F6FB0" StrokeThickness="3" />
                    <Polygon Points="1076,512 1080,520 1084,512" Fill="#2F6FB0" />
                    <Line X1="1130" Y1="550" X2="1190" Y2="550" Stroke="#D17A1F" StrokeThickness="2.4" />
                    <Polygon Points="1184,546 1190,550 1184,554" Fill="#D17A1F" />

                    <!-- Manifold Proses Hattı (Sağa: VALF 6 -> Sensör) -->
                    <Line X1="1080" Y1="420" X2="1120" Y2="420" Stroke="#2F6FB0" StrokeThickness="3.5" />
                    <Line X1="1216" Y1="420" X2="1260" Y2="420" Stroke="#2F6FB0" StrokeThickness="3.5" />
                    <Polygon Points="1254,416 1260,420 1254,424" Fill="#2F6FB0" />

                    <!-- Sensörden Doğrudan ÇIKIŞ Hattı (X=1580..1650, Y=420) -->
                    <Line X1="1580" Y1="420" X2="1650" Y2="420" Stroke="#2F6FB0" StrokeThickness="3.5" />
                    <Polygon Points="1644,416 1650,420 1644,424" Fill="#2F6FB0" />

                    <!-- Keysight ve DP831A Sinyal Hatları (Sensöre Bağlı) -->
                    <Line X1="1420" Y1="225" X2="1420" Y2="310" Stroke="#8E44EC" StrokeThickness="2.4" StrokeDashArray="4,3" />
                    <Polygon Points="1416,302 1420,310 1424,302" Fill="#8E44EC" />

                    <Line X1="1420" Y1="600" X2="1420" Y2="530" Stroke="#8E44EC" StrokeThickness="2.4" StrokeDashArray="4,3" />
