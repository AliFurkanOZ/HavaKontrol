<UserControl x:Class="hava_kontrol.Views.VovgControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:hava_kontrol.Converters"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- BAŞLIK & GENEL V-OVG BAĞLANTI DURUMU        -->
            <!-- ============================================ -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌡" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="V-OVG KONTROL SİSTEMİ" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="4 ÜNİTE — 8 KONTROLCÜ" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VovgStatusText}"
                               Style="{StaticResource CardTitle}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button Content="YENİLE"
                            Command="{Binding ConnectVovgCommand}"
                            Style="{StaticResource OutlineButton}"
                            Height="28" Padding="12,0"
                            FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,8" />

            <!-- ============================================ -->
            <!-- 4 ADET V-OVG CİHAZ KARTI (YAN YANA 4 SÜTUN) -->
            <!-- ============================================ -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding VovgDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,2"
                                Padding="10,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 1. CİHAZ BAŞLIĞI -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: İsim ve Slave Rozeti -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9"
                                                 Fill="{Binding ConnectionStatusColor}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource CardTitle}"
                                                   FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SlaveBadgeText}" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Sağ: Özet Durum -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DeviceStatusSummary}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,6" />

                                <!-- 2. AKIŞ KONTROLCÜSÜ (RCXX) -->
                                <Border Grid.Row="2"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        Background="{StaticResource BgBrush}"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Kart Mini Başlık -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding FlowStatusColor}"
                                                         VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="AKIŞ KONTROLÜ (RCXX)"
                                                           Style="{StaticResource CardTitle}"
                                                           FontSize="11" FontWeight="Bold" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Alm: " Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" />
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding FlowAlarmColor}"
                                                         VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Değerler ve Set Girişi -->
                                        <Grid Grid.Row="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- PV (Gerçek Değer) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="GERÇEK DEBİ" Style="{StaticResource MutedText}" FontSize="9" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FlowPVText, Mode=OneWay}"
                                                           FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </StackPanel>

                                            <!-- SP & Out Bilgisi -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11" Margin="0,0,0,2">
                                                    <Run Text="Hedef: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                    <Run Text="{Binding FlowSetpointText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11">
                                                    <Run Text="Çıkış: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                    <Run Text="{Binding FlowOutputText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Set Girişi -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Text="{Binding FlowSetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A"
                                                             Background="#FFFFFF"
                                                             CaretBrush="#0F172A"
                                                             Width="56" Height="28" FontSize="11" FontWeight="Bold"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyFlowSetpointCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Text="sccm" Style="{StaticResource MutedText}"
                                                               VerticalAlignment="Center" Margin="4,0,5,0" FontSize="10" FontWeight="SemiBold" />
                                                    <Button Content="SET"
                                                            Command="{Binding ApplyFlowSetpointCommand}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Height="28" Padding="8,0"
                                                            FontSize="10" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Text="0 – 250 sccm" Style="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 3. SICAKLIK KONTROLCÜSÜ (RRXX) -->
                                <Border Grid.Row="4"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        Background="{StaticResource BgBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Kart Mini Başlık -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding TempStatusColor}"
                                                         VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="SICAKLIK KONTROLÜ (RRXX)"
                                                           Style="{StaticResource CardTitle}"
                                                           FontSize="11" FontWeight="Bold" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Alm: " Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" />
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding TempAlarmColor}"
                                                         VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Değerler ve Set Girişi -->
                                        <Grid Grid.Row="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- PV (Gerçek Değer) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="GERÇEK SICAKLIK" Style="{StaticResource MutedText}" FontSize="9" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TempPVText, Mode=OneWay}"
                                                           FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>

                                            <!-- SP & Out Bilgisi -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11" Margin="0,0,0,2">
                                                    <Run Text="Hedef: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                    <Run Text="{Binding TempSetpointText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11">
                                                    <Run Text="Çıkış: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                    <Run Text="{Binding TempOutputText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Set Girişi -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Text="{Binding TempSetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A"
                                                             Background="#FFFFFF"
                                                             CaretBrush="#0F172A"
                                                             Width="56" Height="28" FontSize="11" FontWeight="Bold"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyTempSetpointCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Text="°C" Style="{StaticResource MutedText}"
                                                               VerticalAlignment="Center" Margin="4,0,5,0" FontSize="11" FontWeight="SemiBold" />
                                                    <Button Content="SET"
                                                            Command="{Binding ApplyTempSetpointCommand}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Height="28" Padding="8,0"
                                                            FontSize="10" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Text="0 – 100 °C" Style="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 4. CİHAZ HATA MESAJI -->
                                <TextBlock Grid.Row="5"
                                           Text="{Binding ErrorMessage}"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="10" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
