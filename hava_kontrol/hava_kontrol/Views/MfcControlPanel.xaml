<UserControl x:Class="hava_kontrol.Views.MfcControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:hava_kontrol.Converters"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="850">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık, Tüm MFC'leri Kapat ve Genel Güç -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔬" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="MFC KONTROL" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🛑  TÜM KAPAT"
                            Command="{Binding StopAllMfcsCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="14,6"
                            FontSize="12"
                            FontWeight="Bold"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center" />

                    <Rectangle Width="1" Height="20" Fill="{StaticResource CardBorderBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <TextBlock Text="Genel Güç: "
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock Text="{Binding GeneralPowerText}"
                               Style="{StaticResource CardTitle}"
                               Foreground="{Binding GeneralPowerColor}"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,8,0" FontSize="13" />
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsGeneralPowerOn, Mode=TwoWay}"
                                  Width="42" Height="22"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,8" />

            <!-- MFC Kartları (2x2 Grid — Tüm Alanı Doldurur) -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Mfcs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4"
                                Padding="12,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                Background="{StaticResource SurfaceBrush}"
                                VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sütun 0: MFC Adı + Gerçek Debi -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Ellipse Width="9" Height="9"
                                                 Fill="{Binding OnlineStatusColor}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource CardTitle}"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource BgBrush}"
                                                CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SlaveIdText}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Gerçek Debi (Büyük ve Okunaklı) -->
                                    <TextBlock Text="GERÇEK DEBİ"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ActualFlowText, Mode=OneWay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Sütun 1: Setpoint Göstergesi + Setpoint Girişi + Durum -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="4,0,10,0"
                                            Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Hedef Setpoint & Durum -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="12">
                                            <Run Text="Hedef: " Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Run Text="{Binding SetpointText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding FlowStatusColor}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FlowStatusText}"
                                                       Style="{StaticResource CardTitle}"
                                                       Foreground="{Binding FlowStatusColor}"
                                                       FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Setpoint Girişi -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Width="75" Height="32" FontSize="13" FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="SCCM" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11" FontWeight="SemiBold" />
                                        <Button Content="SET"
                                                Command="{Binding ApplySetpointCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="32" Padding="14,0"
                                                FontSize="12" FontWeight="Bold" />
                                    </StackPanel>

                                    <!-- Hata mesajı -->
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Sütun 2: AÇ / KAPAT Butonları -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="AÇ"
                                            Command="{Binding StartFlowCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            Height="34" MinWidth="70"
                                            Padding="14,0"
                                            FontSize="12" FontWeight="Bold"
                                            Margin="0,0,0,4" />
                                    <Button Content="KAPAT"
                                            Command="{Binding StopFlowCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Height="34" MinWidth="70"
                                            Padding="14,0"
                                            FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
