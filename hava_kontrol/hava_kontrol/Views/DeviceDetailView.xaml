<UserControl x:Class="hava_kontrol.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:hava_kontrol.ViewModels"
             xmlns:converters="clr-namespace:hava_kontrol.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="450">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Üst: 4 Hesaplanan Metrik Kartı (Sabit) -->
            <RowDefinition Height="Auto" />
            <!-- 2. Seçili Cihaz Detay Paneli (Tüm Kalan Dikey Alanı Doldurur) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- 1. HESAPLANAN METRİK KARTLARI (KOMPAKT 2x2)  -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,5"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="HESAPLANAN SÜREÇ DEĞERLERİ"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />

                <UniformGrid Grid.Row="1" Columns="2" Rows="2">

                    <!-- Kart 1: Konsantrasyon (ppm) -->
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,0,3,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KONSANTRASYON" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CalculatedConcentrationText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Kart 2: Toplam Debi (sccm) -->
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="3,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOPLAM DEBİ" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalFlowText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Kart 3: Seyreltme Oranı -->
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,3,3,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SEYRELTME" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DilutionRatioText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Kart 4: Denge ve Geçen Süre -->
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="3,3,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding StabilityStatusColor}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding StabilityStatusText}"
                                           FontSize="9.5" FontWeight="Bold"
                                           Foreground="{Binding StabilityStatusColor}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StabilityDurationText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- 2. DİNAMİK SEÇİLİ CİHAZ KONTROL PANELİ        -->
        <!-- ============================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0F172A" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding SelectedDevice}">
                    <ContentControl.Resources>

                        <!-- ======================================== -->
                        <!-- TEMPLATE 1: MFC KONTROLCÜSÜ              -->
                        <!-- ======================================== -->
                        <DataTemplate DataType="{x:Type vm:MfcViewModel}">
                            <StackPanel>
                                <!-- Başlık ve Rozet -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                        <TextBlock Text="{Binding GasName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{Binding FlowStatusColor}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding FlowStatusColor}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FlowStatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,10" />

                                <!-- Gerçek Değer ve Sapma -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="GERÇEK DEBİ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ActualFlowText}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SlaveIdText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="HEDEF / SAPMA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SetpointText}" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding DeviationText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{Binding FlowStatusColor}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Setpoint Girişi -->
                                <TextBlock Text="Hedef Debi Ayarla (0 - 2000 sccm):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="14" FontWeight="Bold"
                                             Foreground="#0F172A"
                                             Background="#FFFFFF"
                                             CaretBrush="#0F172A"
                                             VerticalContentAlignment="Center"
                                             Padding="8,4"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="0,0,6,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding ApplySetpointCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Content="Uygula"
                                            Command="{Binding ApplySetpointCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,0" Height="36"
                                            FontSize="12" />
                                </Grid>

                                <!-- Satır içi Hata Bildirimi (Modal Popup Yok!) -->
                                <TextBlock Text="{Binding SetpointValidationError}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#DC2626"
                                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#DC2626"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,8" />

                                <!-- Tekil Akış Butonu (Ayrı Aç/Kapat Çifti Yok) -->
                                <Button Content="{Binding ToggleFlowText}"
                                        Command="{Binding ToggleFlowCommand}"
                                        Style="{StaticResource NeutralButton}"
                                        Height="36" Margin="0,6,0,0"
                                        FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- ======================================== -->
                        <!-- TEMPLATE 2: HAT VALFİ                    -->
                        <!-- ======================================== -->
                        <DataTemplate DataType="{x:Type vm:ValveViewModel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FunctionalName}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                        <TextBlock Text="{Binding TechnicalTag}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                                <!-- PLC Adres Bilgileri -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC ÇIKIŞI:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlcAddress}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="KOMUT REGISTER:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RegisterAddress}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Border>

                                <!-- Tekil Valf Aç/Kapat Butonu -->
                                <Button Content="{Binding ToggleText, StringFormat='Valfi {0}'}"
                                        Command="{Binding ToggleCommand}"
                                        Style="{StaticResource NeutralButton}"
                                        Height="38" FontSize="13" FontWeight="Bold" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- ======================================== -->
                        <!-- TEMPLATE 3: V-OVG BUHAR FIRINI           -->
                        <!-- ======================================== -->
                        <DataTemplate DataType="{x:Type vm:VovgViewModel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                        <TextBlock Text="{Binding SlaveBadgeText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{Binding ConnectionStatusColor}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding DeviceStatusSummary}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,10" />

                                <!-- Hata / Güvenlik Uyarısı (Varsa) -->
                                <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="#B91C1C" TextWrapping="Wrap" />
                                </Border>

                                <!-- Sıcaklık Kontrolcüsü (RRXX) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="SICAKLIK KONTROLCÜSÜ (0 - 100 °C)" FontSize="10" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ÖLÇÜLEN (PV)" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding TempPVText}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold" Foreground="#D97706" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="HEDEF (SP)" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding TempSetpointText}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding TempSetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Foreground="#0F172A"
                                                     Background="#FFFFFF"
                                                     CaretBrush="#0F172A"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="13" FontWeight="Bold"
                                                     Padding="8,4"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,0,4,0" Height="32">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding ApplyTempSetpointCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="Ayarla" Command="{Binding ApplyTempSetpointCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontWeight="Bold" />
                                        </Grid>
                                        <!-- Hızlı Sıcaklık Seçim Butonları -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="25°C" Command="{Binding QuickSetTempCommand}" CommandParameter="25.0" Height="20" Padding="6,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="35°C" Command="{Binding QuickSetTempCommand}" CommandParameter="35.0" Height="20" Padding="6,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="50°C" Command="{Binding QuickSetTempCommand}" CommandParameter="50.0" Height="20" Padding="6,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="75°C" Command="{Binding QuickSetTempCommand}" CommandParameter="75.0" Height="20" Padding="6,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="100°C" Command="{Binding QuickSetTempCommand}" CommandParameter="100.0" Height="20" Padding="6,0" FontSize="9" Margin="0,0,0,0" Style="{StaticResource NeutralButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Akış Kontrolcüsü (RCXX) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="AKIŞ KONTROLCÜSÜ (0 - 250 sccm)" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ÖLÇÜLEN (PV)" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding FlowPVText}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="HEDEF (SP)" FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding FlowSetpointText}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding FlowSetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Foreground="#0F172A"
                                                     Background="#FFFFFF"
                                                     CaretBrush="#0F172A"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="13" FontWeight="Bold"
                                                     Padding="8,4"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,0,4,0" Height="32">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding ApplyFlowSetpointCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="Ayarla" Command="{Binding ApplyFlowSetpointCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontWeight="Bold" />
                                        </Grid>
                                        <!-- Hızlı Akış Seçim Butonları -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="0 sccm" Command="{Binding QuickSetFlowCommand}" CommandParameter="0.0" Height="20" Padding="5,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="20 sccm" Command="{Binding QuickSetFlowCommand}" CommandParameter="20.0" Height="20" Padding="5,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="50 sccm" Command="{Binding QuickSetFlowCommand}" CommandParameter="50.0" Height="20" Padding="5,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="100 sccm" Command="{Binding QuickSetFlowCommand}" CommandParameter="100.0" Height="20" Padding="5,0" FontSize="9" Margin="0,0,3,0" Style="{StaticResource NeutralButton}" />
                                            <Button Content="200 sccm" Command="{Binding QuickSetFlowCommand}" CommandParameter="200.0" Height="20" Padding="5,0" FontSize="9" Margin="0,0,0,0" Style="{StaticResource NeutralButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ======================================== -->
                                <!-- 4. KAMERA İZLEME PANELİ (V-OVG)          -->
                                <!-- ======================================== -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <!-- Başlık ve Canlı LED Rozeti -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎥" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="KAMERA İZLEME SİSTEMİ" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding CameraStatusColor}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding CameraStatusText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding CameraStatusColor}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Video Önizleme Ekranı (Koyu Çerçeve) -->
                                        <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="6" Height="190" ClipToBounds="True" Margin="0,0,0,8">
                                            <Grid>
                                                <!-- Canlı Video Görüntüsü -->
                                                <Image Source="{Binding CameraFrame}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                                <!-- Kapalı Durum Kartı (Kamera Yayını Başlatılmamışken) -->
                                                <Border Background="#0B0F19"
                                                        Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="📹" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                        <TextBlock Text="Kamera Yayını Kapalı" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                        <Button Content="YAYINI BAŞLAT"
                                                                Command="{Binding ToggleCameraCommand}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Height="28" Padding="16,0" FontSize="10.5" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Hata Bildirimi (Varsa) -->
                                                <Border Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Visibility="{Binding HasCameraError, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding CameraError}" FontSize="9.5" Foreground="#FEF2F2" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Anlık Fotoğraf Bildirim Rozeti (Toast) -->
                                                <Border Background="#059669" CornerRadius="4" Padding="8,4" Margin="8"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="{Binding SnapshotNotification, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding SnapshotNotification}" FontSize="9.5" Foreground="#FFFFFF" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Kamera Seçimi ve Hızlı Aksiyonlar (DockPanel ile sağdaki buton daima yerinde kalır, taşma yapmaz) -->
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <!-- Sağ: Yenile Butonu (Açık metin, ferah padding, sabit durur) -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="🔄 Yenile"
                                                    Command="{Binding RefreshCamerasCommand}"
                                                    ToolTip="Kamera Aygıtlarını Yeniden Tara"
                                                    Height="28" Padding="10,0"
                                                    FontSize="10" FontWeight="Bold"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource NeutralButton}" />

                                            <!-- Sol: Cihaz Seçim ComboBox (Kalan alanı doldurur, metin uzunsa ... ile keser) -->
                                            <ComboBox ItemsSource="{Binding AvailableCameras}"
                                                      SelectedItem="{Binding SelectedCamera}"
                                                      MinWidth="0"
                                                      Height="28" FontSize="10"
                                                      Style="{StaticResource ModernComboBox}"
                                                      VerticalContentAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DockPanel>

                                        <!-- Hızlı Kumanda Butonları: 2 Sütunlu Dengeli Sıra (Başlat ve Fotoğraf) -->
                                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,5">
                                            <!-- 1. Başlat / Durdur (Aktifken kırmızı, kapalıyken mavi) -->
                                            <Button Content="{Binding CameraToggleText}"
                                                    Command="{Binding ToggleCameraCommand}"
                                                    Height="28" FontSize="10" FontWeight="Bold"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCameraActive}" Value="True">
                                                                <Setter Property="Background" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 2. Fotoğraf Çek -->
                                            <Button Content="📸 FOTOĞRAF"
                                                    Command="{Binding TakeSnapshotCommand}"
                                                    Style="{StaticResource NeutralButton}"
                                                    Height="28" FontSize="10" FontWeight="Bold"
                                                    Margin="2,0,0,0" />
                                        </UniformGrid>

                                        <!-- Tam Ekran / Genişlet Butonu (Tüm alana yayılan, ferah ve asla taşmayan buton) -->
                                        <Button Content="⛶ TAM EKRAN CANLI İZLEME"
                                                Command="{Binding OpenFullViewCommand}"
                                                Style="{StaticResource OutlineButton}"
                                                Height="28" FontSize="10" FontWeight="Bold"
                                                BorderBrush="#0284C7" Foreground="#0284C7"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ======================================== -->
                        <!-- TEMPLATE 4: KEYSIGHT B2902B SMU           -->
                        <!-- ======================================== -->
                        <DataTemplate DataType="{x:Type vm:ElectrometerViewModel}">
                            <StackPanel Margin="0,0,0,10">
                                <!-- 1. BAŞLIK VE KANAL SEÇİMİ -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ KEYSIGHT B2902B" Style="{StaticResource SectionTitle}" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="2-CH SMU" FontSize="10" FontWeight="Bold" Foreground="#8B5CF6" Margin="6,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Hassas Kaynak &amp; Ölçüm Ünitesi (±210V, ±1.5A)" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{Binding ConnectionStatusColor}" BorderThickness="1.5" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,8" />

                                <!-- KANAL SEÇİMİ (CH1 / CH2) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="⚡ KANAL 1 (CH1)" Command="{Binding SelectChannel1Command}" Height="32" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChannel1Selected}" Value="True">
                                                        <Setter Property="Background" Value="#8B5CF6" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="2" Content="⚡ KANAL 2 (CH2)" Command="{Binding SelectChannel2Command}" Height="32" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChannel2Selected}" Value="True">
                                                        <Setter Property="Background" Value="#8B5CF6" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 2. BÖLÜM: CANLI ÖLÇÜM EKRANI (MONİTÖR) -->
                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Ölçüm Fonksiyonu Seçimi (A, V, Ω) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Segmentli Ölçüm Modu Butonları -->
                                            <UniformGrid Grid.Column="0" Columns="3">
                                                <Button Content="AKIM (A)" Command="{Binding SetCurrentFuncCommand}" Height="26" FontSize="10" FontWeight="Bold" Margin="0,0,2,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentMode}" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="VOLTAJ (V)" Command="{Binding SetVoltageFuncCommand}" Height="26" FontSize="10" FontWeight="Bold" Margin="2,0,2,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVoltageMode}" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="DİRENÇ (Ω)" Command="{Binding SetResistanceFuncCommand}" Height="26" FontSize="10" FontWeight="Bold" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsResistanceMode}" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </UniformGrid>

                                            <!-- HV Uyarı Rozeti -->
                                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1"
                                                    CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding HasHvWarning, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="⚠ HV >42V" FontSize="8.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                            </Border>
                                        </Grid>

                                        <!-- Büyük Dijital Ölçüm Değeri -->
                                        <TextBlock Text="{Binding MeasurementText}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="34" FontWeight="Bold"
                                                   Foreground="#38BDF8"
                                                   TextAlignment="Center" Margin="0,4,0,8" />

                                        <!-- Canlı 3'lü Eşzamanlı Telemetri Barı -->
                                        <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                            <UniformGrid Columns="3">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="AKIM: " FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CurrentText}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="#C084FC" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="VOLTAJ: " FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VoltageText}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="#FBBF24" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="DİRENÇ: " FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ResistanceText}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="#34D399" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 3. BÖLÜM: KAYNAK KONTROLÜ VE DEĞER GİRİŞİ (SOURCE) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Mod Seçici Tab (Voltaj Kaynağı / Akım Kaynağı) -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="⚡ VOLTAJ KAYNAĞI" Command="{Binding SetVoltageSourceModeCommand}"
                                                            Height="24" Padding="12,0" FontSize="9.5" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVoltageSourceMode}" Value="True">
                                                                        <Setter Property="Background" Value="#3B82F6" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="⚡ AKIM KAYNAĞI" Command="{Binding SetCurrentSourceModeCommand}"
                                                            Height="24" Padding="12,0" FontSize="9.5" FontWeight="Bold" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVoltageSourceMode}" Value="False">
                                                                        <Setter Property="Background" Value="#8B5CF6" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- Aktif Kaynak Ayarı Özeti -->
                                            <TextBlock Grid.Column="1" Text="{Binding SourceModeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- A. VOLTAJ KAYNAĞI GİRİŞLERİ (IsVoltageSourceMode == True) -->
                                        <StackPanel Visibility="{Binding IsVoltageSourceMode, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Hedef Voltaj Girişi -->
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <!-- Akım Limiti Girişi -->
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Voltaj Girişi -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Hedef Voltaj (V):" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding VoltageSourceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A" Background="#FFFFFF" CaretBrush="#0F172A"
                                                             Height="32" FontSize="13" FontWeight="Bold" Padding="8,4">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyVoltageSourceCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="0V" Command="{Binding QuickSetVoltageCommand}" CommandParameter="0.0" Height="18" Padding="5,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="1V" Command="{Binding QuickSetVoltageCommand}" CommandParameter="1.0" Height="18" Padding="5,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="5V" Command="{Binding QuickSetVoltageCommand}" CommandParameter="5.0" Height="18" Padding="5,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="10V" Command="{Binding QuickSetVoltageCommand}" CommandParameter="10.0" Height="18" Padding="5,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Akım Limiti (Compliance) Girişi -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Akım Sınırı (mA):" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding CurrentComplianceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A" Background="#FFFFFF" CaretBrush="#0F172A"
                                                             Height="32" FontSize="13" FontWeight="Bold" Padding="8,4">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyVoltageSourceCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="1mA" Command="{Binding QuickSetComplianceCommand}" CommandParameter="1" Height="18" Padding="4,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="10mA" Command="{Binding QuickSetComplianceCommand}" CommandParameter="10" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="50mA" Command="{Binding QuickSetComplianceCommand}" CommandParameter="50" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="100mA" Command="{Binding QuickSetComplianceCommand}" CommandParameter="100" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Büyük Uygula Butonu -->
                                            <Button Content="⚡ VOLTAJ KAYNAĞINI AYARLA VE UYGULA"
                                                    Command="{Binding ApplyVoltageSourceCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Height="34" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>

                                        <!-- B. AKIM KAYNAĞI GİRİŞLERİ (IsVoltageSourceMode == False) -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoltageSourceMode}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Hedef Akım Girişi -->
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <!-- Voltaj Limiti Girişi -->
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Akım Girişi -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Hedef Akım (mA):" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding CurrentSourceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A" Background="#FFFFFF" CaretBrush="#0F172A"
                                                             Height="32" FontSize="13" FontWeight="Bold" Padding="8,4">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyCurrentSourceCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="0.1mA" Command="{Binding QuickSetCurrentCommand}" CommandParameter="0.1" Height="18" Padding="4,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="1mA" Command="{Binding QuickSetCurrentCommand}" CommandParameter="1.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="10mA" Command="{Binding QuickSetCurrentCommand}" CommandParameter="10.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="50mA" Command="{Binding QuickSetCurrentCommand}" CommandParameter="50.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Voltaj Limiti (Compliance) Girişi -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Voltaj Sınırı (V):" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding VoltageComplianceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Foreground="#0F172A" Background="#FFFFFF" CaretBrush="#0F172A"
                                                             Height="32" FontSize="13" FontWeight="Bold" Padding="8,4">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding ApplyCurrentSourceCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="5V" Command="{Binding QuickSetComplianceCommand}" CommandParameter="5.0" Height="18" Padding="4,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="10V" Command="{Binding QuickSetComplianceCommand}" CommandParameter="10.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="21V" Command="{Binding QuickSetComplianceCommand}" CommandParameter="21.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="40V" Command="{Binding QuickSetComplianceCommand}" CommandParameter="40.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Büyük Uygula Butonu -->
                                            <Button Content="⚡ AKIM KAYNAĞINI AYARLA VE UYGULA"
                                                    Command="{Binding ApplyCurrentSourceCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Height="34" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. BÖLÜM: ÇIKIŞ KONTROLÜ (OUTPUT ON / OFF) -->
                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Çıkış Durumu Rozeti -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="DONANIM ÇIKIŞI (OUTPUT):" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Ellipse Width="8" Height="8" Fill="{Binding OutputStatusColor}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding OutputStatusText}" Foreground="{Binding OutputStatusColor}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding SourceModeText}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Büyük Hızlı ON / OFF Butonları -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="▶ OUTPUT ON (AÇ)"
                                                    Command="{Binding TurnOnOutputCommand}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Height="36" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />

                                            <Button Grid.Column="2" Content="⏹ OUTPUT OFF (KAPAT)"
                                                    Command="{Binding TurnOffOutputCommand}"
                                                    Style="{StaticResource DangerButton}"
                                                    Height="36" FontSize="11.5" FontWeight="Bold" Cursor="Hand" />
                                        </Grid>
