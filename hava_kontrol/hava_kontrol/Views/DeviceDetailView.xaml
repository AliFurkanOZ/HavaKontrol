                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="GERÇEK GERİLİM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Ch3VoltageActualText}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="GERÇEK AKIM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Ch3CurrentActualText}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="GÜÇ TÜKETİMİ" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Ch3PowerActualText}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>

                                        <!-- Değer Ayarlama (V Set & I Set) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Voltaj Ayar -->
                                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="4" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock Text="Negatif Gerilim (-32V - 0V):" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Ch3VoltageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="13" FontWeight="Bold"
                                                                 Padding="8,4"
                                                                 VerticalContentAlignment="Center"
                                                                 Style="{StaticResource ModernTextBox}"
                                                                 Height="32" Margin="0,0,4,0">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return" Command="{Binding ApplyCh3VoltageCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <Button Grid.Column="1" Content="SET" Command="{Binding ApplyCh3VoltageCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontSize="11" FontWeight="Bold" />
                                                    </Grid>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="0V" Command="{Binding QuickSetCh3VoltageCommand}" CommandParameter="0.0" Height="18" Padding="5,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="-5V" Command="{Binding QuickSetCh3VoltageCommand}" CommandParameter="-5.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="-12V" Command="{Binding QuickSetCh3VoltageCommand}" CommandParameter="-12.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="-24V" Command="{Binding QuickSetCh3VoltageCommand}" CommandParameter="-24.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="-30V" Command="{Binding QuickSetCh3VoltageCommand}" CommandParameter="-30.0" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Akım Ayar -->
                                            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock Text="Akım Limiti (0 - 2.1A):" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding Ch3CurrentInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="13" FontWeight="Bold"
                                                                 Padding="8,4"
                                                                 VerticalContentAlignment="Center"
                                                                 Style="{StaticResource ModernTextBox}"
                                                                 Height="32" Margin="0,0,4,0">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return" Command="{Binding ApplyCh3CurrentCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <Button Grid.Column="1" Content="SET" Command="{Binding ApplyCh3CurrentCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontSize="11" FontWeight="Bold" />
                                                    </Grid>
                                                    <!-- Hızlı Seçim Butonları -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="0.2A" Command="{Binding QuickSetCh3CurrentCommand}" CommandParameter="0.2" Height="18" Padding="4,0" FontSize="8.5" Margin="0,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="0.5A" Command="{Binding QuickSetCh3CurrentCommand}" CommandParameter="0.5" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="1A" Command="{Binding QuickSetCh3CurrentCommand}" CommandParameter="1.0" Height="18" Padding="5,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="1.5A" Command="{Binding QuickSetCh3CurrentCommand}" CommandParameter="1.5" Height="18" Padding="4,0" FontSize="8.5" Margin="2,0,2,0" Style="{StaticResource NeutralButton}" />
                                                        <Button Content="2A" Command="{Binding QuickSetCh3CurrentCommand}" CommandParameter="2.0" Height="18" Padding="5,0" FontSize="8.5" Margin="2,0,0,0" Style="{StaticResource NeutralButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>

                        <!-- ======================================== -->
                        <!-- TEMPLATE 6: GÜÇ ÇIKIŞI                   -->
                        <!-- ======================================== -->
                        <DataTemplate DataType="{x:Type vm:PowerOutputViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding FunctionalName}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                <TextBlock Text="{Binding OutputName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,10" />
                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,10" />
                                <Button Content="{Binding ToggleText, StringFormat='Çıkışı {0}'}"
                                        Command="{Binding ToggleCommand}"
                                        Style="{StaticResource NeutralButton}"
                                        Height="38" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
