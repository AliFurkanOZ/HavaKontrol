<UserControl x:Class="hava_kontrol.Views.ValveControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="420">

    <Border Style="{StaticResource CardBorder}" Padding="12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık ve Tüm Valfleri Kapat -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="VALF KONTROL" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🛑  TÜM KAPAT"
                        Command="{Binding CloseAllValvesCommand}"
                        Style="{StaticResource DangerButton}"
                        Padding="10,3"
                        Height="26"
                        FontSize="11"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Tablo Başlığı (Durum sağa kaydırılmış) -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="VALF"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10" />
                <TextBlock Grid.Column="1" Text="DURUM"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10"
                           Margin="0,0,16,0"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="KONTROL"
                           Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" FontSize="10"
                           TextAlignment="Center" />
            </Grid>

            <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,3" />

            <!-- Valf Listesi (12 Valf: 8 Hat Valfi + 4 V-OVG Tahliye Valfi) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AllValves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,2" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    VerticalAlignment="Stretch">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Valf Adı ve Teknik Etiket -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FunctionalName}"
                                                   Style="{StaticResource CardTitle}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TechnicalTag}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Durum Göstergesi (Sağa kaydırılmış) -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding StatusColor}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Margin="5,0,0,0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Kontrol Butonları (Sağa dayalı grup) -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="AÇ"
                                                Command="{Binding OpenCommand}"
                                                Style="{StaticResource SuccessButton}"
                                                Height="24" Width="46"
                                                Padding="0"
                                                Margin="0,0,5,0"
                                                FontSize="11" FontWeight="Bold" />
                                        <Button Content="KAPAT"
                                                Command="{Binding CloseCommand}"
                                                Style="{StaticResource DangerButton}"
                                                Height="24" Width="52"
                                                Padding="0"
                                                FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
