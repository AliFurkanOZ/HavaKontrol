<Window x:Class="hava_kontrol.Views.VovgCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:hava_kontrol.Converters"
        mc:Ignorable="d"
        Title="{Binding DisplayName, StringFormat='🎥 {0} — Kamera Canlı İzleme &amp; Kayıt'}"
        Width="1080" Height="760"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Dinamik Başlat/Durdur Buton Stili (Yayındayken kırmızı, kapalıyken mavi) -->
        <Style x:Key="CameraToggleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCameraActive}" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. Üst Bar: Başlık, Telemetri ve Cihaz Bilgisi -->
            <RowDefinition Height="Auto" />
            <!-- 2. Ana Canlı Video Ekranı -->
            <RowDefinition Height="*" />
            <!-- 3. Alt Kontrol Paneli -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- 1. ÜST BAŞLIK & TELEMETRİ                    -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol: Cihaz Bilgisi -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#38BDF8" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="🎥 CANLI İZLEME" FontSize="11" FontWeight="Bold" Foreground="#0F172A" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#0F172A" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SlaveBadgeText}" FontSize="11" Foreground="#94A3B8" />
                    </Border>
                </StackPanel>

                <!-- Sağ: Canlı Telemetri Rozetleri -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sıcaklık -->
                    <Border Background="#0F172A" BorderBrush="#D97706" BorderThickness="1.5" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌡 SICAKLIK: " FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TempPVText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Debi -->
                    <Border Background="#0F172A" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💨 DEBİ: " FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FlowPVText}" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Durum Göstergesi -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding CameraStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CameraStatusText}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- 2. VİDEO YAYIN EKRANI                        -->
        <!-- ============================================ -->
        <Border Grid.Row="1"
                Background="#020617"
                BorderBrush="#1E293B"
                BorderThickness="2"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <!-- Canlı Görüntü -->
                <Image Source="{Binding CameraFrame}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Kamera Kapalıyken Gösterilen Zemin / Buton -->
                <Border Background="#0B0F19"
                        Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📹" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Kamera Yayını Başlatılmadı"
                                   FontSize="16" FontWeight="Bold" Foreground="#E2E8F0"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Canlı izlemek veya simülasyon akışını başlatmak için aşağıdaki butona tıklayın."
                                   FontSize="12" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Content="▶ YAYINI BAŞLAT"
                                Command="{Binding ToggleCameraCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="40" Padding="26,0" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Hata Bildirimi (Varsa) -->
                <Border Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="1"
                        CornerRadius="6" Padding="12,6" Margin="16"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Visibility="{Binding HasCameraError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CameraError}" FontSize="11" Foreground="#FEF2F2" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Bildirim Toast (Fotoğraf Çekildi vb.) -->
                <Border Background="#10B981"
                        CornerRadius="6"
                        Padding="14,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="16"
                        Visibility="{Binding SnapshotNotification, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SnapshotNotification}"
                               Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- 3. ALT ARAÇ ÇUBUĞU (KONTROLLER - 2 SATIRLI)   -->
        <!-- ============================================ -->
        <Border Grid.Row="2"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Satır 1: Kamera Kaynağı & Telemetri Seçimi -->
                    <RowDefinition Height="Auto" />
                    <!-- Ayırıcı Çizgi -->
                    <RowDefinition Height="Auto" />
                    <!-- Satır 2: Operasyonel Aksiyon Butonları -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- SATIR 1: KAYNAK SEÇİMİ VE OSD KATMANI -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Cihaz Kaynağı & Yeniden Tara -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0F172A" CornerRadius="4" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="📹 KAYNAK" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                        <ComboBox ItemsSource="{Binding AvailableCameras}"
                                  SelectedItem="{Binding SelectedCamera}"
                                  Width="260" Height="32"
                                  Style="{StaticResource ModernComboBox}"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Kamera Aygıtlarını Yeniden Tara Butonu (Açık, net ve şık) -->
                        <!-- Kamera Aygıtlarını Yeniden Tara Butonu (Fotoğraf Çek ile aynı NeutralButton stilinde) -->
                        <Button Content="🔄 Yeniden Tara"
                                Command="{Binding RefreshCamerasCommand}"
                                ToolTip="Bağlı kamera aygıtlarını yeniden tara ve listeyi güncelle"
                                Height="32" Padding="14,0"
                                Margin="8,0,0,0"
                                Style="{StaticResource NeutralButton}"
                                FontWeight="Bold" FontSize="11" />
                    </StackPanel>

                    <!-- Sağ: OSD Telemetri Katmanı -->
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding ShowOsdTelemetry}"
                              Content="Canlı Telemetri Katmanı (OSD)"
                              FontSize="11" FontWeight="SemiBold"
                              Foreground="#E2E8F0"
                              VerticalAlignment="Center"
                              Cursor="Hand" />
                </Grid>

                <!-- AYIRICI ÇİZGİ -->
                <Rectangle Grid.Row="1" Height="1" Fill="#334155" Margin="0,0,0,8" />

                <!-- SATIR 2: AKSİYON BUTONLARI (FERAH, UYUMLU, AYNI STİLDE) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Durum Bilgi Notu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding CameraStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CameraStatusText, StringFormat='Durum: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Sağ: Ana Kontrol Butonları (Hepsi Uyumlu ve Aynı Stilde) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Kayıt Klasörü (Fotoğraf çek ile aynı NeutralButton stili) -->
                        <Button Content="📂 KLASÖRÜ AÇ"
                                Command="{Binding OpenSnapshotFolderCommand}"
                                Style="{StaticResource NeutralButton}"
                                ToolTip="Kaydedilen fotoğrafların bulunduğu klasörü aç"
                                Height="34" Padding="14,0" FontSize="11" FontWeight="Bold"
                                Margin="0,0,8,0" />

                        <!-- 2. Fotoğraf Çek (NeutralButton stili) -->
                        <Button Content="📸 FOTOĞRAF ÇEK"
                                Command="{Binding TakeSnapshotCommand}"
                                Style="{StaticResource NeutralButton}"
                                ToolTip="Anlık yüksek çözünürlüklü görüntü yakala ve diske kaydet"
                                Height="34" Padding="16,0" FontSize="11" FontWeight="Bold"
                                Margin="0,0,8,0" />

                        <!-- 3. Tam Ekran / Pencere Modu Butonu (Fotoğraf ile aynı NeutralButton stili) -->
                        <Button x:Name="BtnFullscreen"
                                Content="⛶ TAM EKRAN"
                                Click="FullscreenButton_Click"
                                Style="{StaticResource NeutralButton}"
                                ToolTip="Ekranı Kapla / Tam Ekran Moduna Geç"
                                Height="34" Padding="14,0" FontSize="11" FontWeight="Bold"
                                Margin="0,0,10,0" />

                        <!-- 4. Başlat / Durdur (Dinamik Renk Değişen Ana Buton) -->
                        <Button Content="{Binding CameraToggleText}"
                                Command="{Binding ToggleCameraCommand}"
                                Style="{StaticResource CameraToggleButtonStyle}"
                                Height="34" Padding="22,0" FontSize="11" FontWeight="Bold"
                                ToolTip="Kamera akışını başlat veya sonlandır" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
